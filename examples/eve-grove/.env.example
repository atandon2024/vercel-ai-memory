# ── GROVE (OpenAI-compatible chat gateway) ──────────────────────────────
GROVE_API_KEY=your-grove-key
# Optional overrides:
# GROVE_BASE_URL=https://grove-gateway-prod.azure-api.net/grove-foundry-prod/openai/v1
# GROVE_MODEL=gpt-6-astra
# GROVE_CONTEXT_WINDOW=128000   # context window for compaction (direct provider)


# ── MongoDB Atlas ───────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/
# Voyage AI model for Atlas Automated Embedding (requires Voyage AI enabled on your org)
# VOYAGE_MODEL=voyage-4

# ── Local dev identity ──────────────────────────────────────────────────
# Eve's memory partition key = digest(namespace + scope). BOTH must be stable
# across restarts or the agent writes to a fresh partition every run.
# Pins a STABLE principal so memory scope is the same across `eve dev` /
# `eve invoke` restarts (see agent/memory/profile.ts). Change it to simulate a
# different user; memory is isolated per value.
DEV_PRINCIPAL_ID=workshop-user
# Stable memory namespace (eve's default includes the build-root hash, which
# changes every start). Change it to start a fresh memory space.
# MEMORY_NAMESPACE=eve-grove-memory-agent/profile
# Set to 1 to use real per-authenticated-user scope (byPrincipal) instead.
# EVE_MEMORY_PROD=1
